# כתובת השרת שהדפדפן פונה אליו.
# השאירו ריק ב-dev: הבקשות יוצאות ל-/api ו-Vite מעביר אותן ל-API_PROXY_TARGET (בלי CORS).
# בפרודקשן הגדירו כתובת מלאה, למשל https://api.example.com, והוסיפו CORS בשרת.
VITE_API_URL=

# לאן ה-proxy של Vite מעביר (מספיק לשנות כאן אם הפורט שלכם שונה).
API_PROXY_TARGET=https://localhost:7000

# auto  = נתונים אמיתיים, ואם השרת לא זמין (או שאין הרשאה לצפות בטיסות) עוברים לנתוני הדגמה
# live  = רק השרת
# demo  = רק נתוני הדגמה (כולל כניסה מדומה והזמנה מקומית)
VITE_DATA_MODE=auto
